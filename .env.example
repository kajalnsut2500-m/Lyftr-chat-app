# Comma-separated key pool, at least 2 keys. Key ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2
# LiteLLM model name
LLM_MODEL=gemini/gemini-3.5-flash-lite
# SQLite file (lives on the Docker volume mounted at /data)
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (your frontend URL)
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test header
ENABLE_FAILURE_SIMULATION=true
# Seconds before a provider call times out
LLM_TIMEOUT=30
# Frontend build argument: the backend URL the browser calls
VITE_API_URL=http://localhost:8000
